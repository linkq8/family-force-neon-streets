{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familyforce.local/schemas/art-manifest-1.0.json",
  "title": "Family Force Character Art Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "actor",
    "logicalCanvas",
    "pixelsPerUnit",
    "pivot",
    "runtimeTiers",
    "actions",
    "provenance"
  ],
  "properties": {
    "contractVersion": { "type": "string", "pattern": "^ff-art-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "profileVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "class": { "enum": ["hero", "regular_enemy", "elite", "mini_boss", "boss"] },
        "profileVersion": { "type": "string", "minLength": 1 }
      }
    },
    "logicalCanvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 256, "maximum": 1024 },
        "height": { "type": "integer", "minimum": 256, "maximum": 1024 }
      }
    },
    "pixelsPerUnit": { "type": "number", "exclusiveMinimum": 0 },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    },
    "runtimeTiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scale", "maxAtlasSize"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "scale": { "type": "number", "minimum": 0.25, "maximum": 1.0 },
          "maxAtlasSize": { "enum": [1024, 2048] },
          "renderHeightMin": { "type": "integer", "minimum": 480 },
          "renderHeightMax": { "type": "integer", "minimum": 480 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "playbackFps", "loop", "frames"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "playbackFps": { "type": "number", "minimum": 12, "maximum": 30 },
          "loop": { "type": "boolean" },
          "frames": {
            "type": "array",
            "minItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sequence", "master", "masterSha256", "runtime", "runtimeSha256"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 0 },
                "master": { "type": "string", "pattern": "\\.png$" },
                "masterSha256": { "$ref": "#/$defs/sha256" },
                "runtime": { "type": "string", "pattern": "\\.png$" },
                "runtimeSha256": { "$ref": "#/$defs/sha256" },
                "intentionalGeometryException": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTool", "rightsRecord", "recipeVersion"],
      "properties": {
        "sourceTool": { "type": "string", "minLength": 1 },
        "rightsRecord": { "type": "string", "minLength": 1 },
        "recipeVersion": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
